# Copy this file to .env and adjust as needed.

# JSON-RPC endpoints for the two local Hardhat nodes.
RPC_URL_A=http://127.0.0.1:8545
RPC_URL_B=http://127.0.0.1:8546

# Private key the relayer uses to submit receiveMessage() transactions.
# Defaults to Hardhat's well-known test account #0 if unset — DO NOT use
# that key (or this variable) with real funds or a public network.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
